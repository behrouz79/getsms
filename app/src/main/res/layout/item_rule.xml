<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginVertical="5dp"
    android:background="@drawable/bg_card"
    android:padding="16dp">

    <!-- Rule name + toggle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvRuleName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="@font/shabnam_bold"
            android:textColor="@color/claude_text_primary" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchEnabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/shabnam" />

    </LinearLayout>

    <!-- Conditions summary -->
    <TextView
        android:id="@+id/tvRuleConditions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="13sp"
        android:fontFamily="@font/shabnam"
        android:textColor="@color/claude_text_secondary" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/claude_divider"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="10dp" />

    <!-- Action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCopy"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:fontFamily="@font/shabnam"
            android:text="@string/copy"
            android:textSize="12sp"
            android:textColor="@color/claude_text_secondary"
            android:background="@drawable/btn_outline" />

        <Button
            android:id="@+id/btnEdit"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/shabnam"
            android:text="@string/edit"
            android:textSize="12sp"
            android:background="@drawable/btn_primary"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btnDelete"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/shabnam"
            android:text="@string/delete"
            android:textSize="12sp"
            android:textColor="@color/claude_error"
            android:background="@android:color/transparent"
            style="@style/Widget.MaterialComponents.Button.TextButton" />

    </LinearLayout>

</LinearLayout>
