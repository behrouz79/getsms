<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/claude_bg"
    tools:context=".MainActivity">

    <!-- Top panel: header + controls -->
    <LinearLayout
        android:id="@+id/topPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- App header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="@font/shabnam_bold"
                android:textColor="@color/claude_text_primary" />

            <Button
                android:id="@+id/tvCreditsDisplay"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_tag_amber"
                android:fontFamily="@font/shabnam"
                android:paddingHorizontal="12dp"
                android:text="@string/credits"
                android:textColor="@color/claude_primary_dark"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Service control card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:padding="14dp"
            android:orientation="vertical"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/service_status"
                    android:textSize="13sp"
                    android:fontFamily="@font/shabnam"
                    android:textColor="@color/claude_text_secondary" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnStart"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/btn_success"
                    android:fontFamily="@font/shabnam"
                    android:text="@string/start_service"
                    android:textColor="@color/white"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnStart2"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_error"
                    android:fontFamily="@font/shabnam"
                    android:text="@string/stop_service"
                    android:textColor="@color/white"
                    android:textSize="14sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Action row: Rules / Language / Credits / Clear -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <Button
                android:id="@+id/btnOpenRules"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:background="@drawable/btn_primary"
                android:fontFamily="@font/shabnam"
                android:text="@string/manage_rules"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnCredits"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:background="@drawable/btn_outline"
                android:fontFamily="@font/shabnam"
                android:text="@string/manage_credits"
                android:textColor="@color/claude_text_primary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnLanguage"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:background="@drawable/btn_outline"
                android:fontFamily="@font/shabnam"
                android:text="@string/change_language"
                android:textColor="@color/claude_text_primary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnDelete"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/btn_outline"
                android:fontFamily="@font/shabnam"
                android:text="@string/cleanup_record"
                android:textColor="@color/claude_text_primary"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Filter chips -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <Button
                android:id="@+id/btnShowAll"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/btn_primary"
                android:fontFamily="@font/shabnam"
                android:text="All"
                android:textColor="@color/white"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnShowSuccess"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/btn_outline"
                android:fontFamily="@font/shabnam"
                android:text="Success"
                android:textColor="@color/claude_text_primary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnShowFailed"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/btn_outline"
                android:fontFamily="@font/shabnam"
                android:text="Failed"
                android:textColor="@color/claude_text_primary"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- Stats bar -->
        <TextView
            android:id="@+id/tvStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:fontFamily="@font/shabnam"
            android:padding="10dp"
            android:text="Loading..."
            android:textColor="@color/claude_text_secondary"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Section label -->
    <TextView
        android:id="@+id/tvLogsLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="4dp"
        android:text="@string/action_logs"
        android:textSize="12sp"
        android:textStyle="bold"
        android:fontFamily="@font/shabnam"
        android:textColor="@color/claude_text_hint"
        android:textAllCaps="true"
        app:layout_constraintTop_toBottomOf="@id/topPanel"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Log list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recRequ"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingHorizontal="12dp"
        android:paddingBottom="12dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/tvLogsLabel"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
