<?xml version="1.0" encoding="utf-8"?>
<!-- Root uses strip_success/strip_error layer-list as background.
     The 3dp colored left rail is baked into the drawable. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_marginVertical="4dp"
    android:background="@drawable/strip_success"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:paddingEnd="12dp"
    android:paddingStart="13dp">

    <!-- Content (starts 13dp in — 12dp padding + 1dp to visually clear the rail) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Row 1: status icon + action type + time -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:text="✓"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tvActionType"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="WEBHOOK"
                android:textSize="13sp"
                android:fontFamily="@font/shabnam_bold"
                android:textColor="@color/text_primary"
                android:textAllCaps="true"
                android:letterSpacing="0.04" />

            <TextView
                android:id="@+id/tvTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12:34"
                android:textSize="11sp"
                android:fontFamily="@font/shabnam"
                android:textColor="@color/text_muted" />

        </LinearLayout>

        <!-- Row 2: destination (monospace) -->
        <TextView
            android:id="@+id/tvDestination"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="https://api.example.com/webhook"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textColor="@color/text_secondary"
            android:ellipsize="end"
            android:maxLines="1"
            android:layout_marginTop="3dp" />

        <!-- Row 3: duration + status code -->
        <TextView
            android:id="@+id/tvDuration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="142 ms  ·  200"
            android:textSize="11sp"
            android:fontFamily="@font/shabnam"
            android:textColor="@color/text_muted"
            android:layout_marginTop="2dp" />

        <!-- Row 4: badges -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/tvRetryBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="retry 2/3"
                android:textSize="10sp"
                android:fontFamily="@font/shabnam_bold"
                android:textColor="@color/primary_dark"
                android:textAllCaps="true"
                android:letterSpacing="0.06"
                android:background="@drawable/bg_badge_primary"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2dp"
                android:layout_marginEnd="6dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvBackupBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="backup ✓"
                android:textSize="10sp"
                android:fontFamily="@font/shabnam_bold"
                android:textColor="@color/info"
                android:textAllCaps="true"
                android:letterSpacing="0.06"
                android:background="@drawable/bg_badge_neutral"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2dp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Error message -->
        <TextView
            android:id="@+id/tvErrorMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:fontFamily="@font/shabnam"
            android:textColor="@color/error"
            android:layout_marginTop="4dp"
            android:visibility="gone" />

        <!-- Response body (monospace, success only) -->
        <TextView
            android:id="@+id/tvResponse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
