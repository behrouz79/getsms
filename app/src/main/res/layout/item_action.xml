<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginVertical="5dp"
    android:background="@drawable/bg_card"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvActionType"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="@font/shabnam_bold"
            android:textColor="@color/claude_primary"
            android:text="@string/action_type" />

        <Button
            android:id="@+id/btnEditAction"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:fontFamily="@font/shabnam"
            android:text="@string/edit"
            android:textSize="12sp"
            android:textColor="@color/claude_text_secondary"
            android:background="@android:color/transparent"
            style="@style/Widget.MaterialComponents.Button.TextButton" />

        <Button
            android:id="@+id/btnDeleteAction"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:fontFamily="@font/shabnam"
            android:text="@string/delete"
            android:textSize="12sp"
            android:textColor="@color/claude_error"
            android:background="@android:color/transparent"
            style="@style/Widget.MaterialComponents.Button.TextButton" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvDestination"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textSize="12sp"
        android:fontFamily="@font/shabnam"
        android:textColor="@color/claude_text_secondary"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/destination_hint" />

    <TextView
        android:id="@+id/tvTemplate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="11sp"
        android:fontFamily="@font/shabnam"
        android:textColor="@color/claude_text_hint"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/template_hint" />

</LinearLayout>
