<?xml version="1.0" encoding="utf-8"?>
<!--activity rule editor-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Header -->
            <TextView
                android:fontFamily="@font/shabnam"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/create_edit_rule"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:layout_marginBottom="16dp" />

            <!-- Rule Name -->
            <TextView
                android:fontFamily="@font/shabnam"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/rule_name"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />

            <EditText
                android:fontFamily="@font/shabnam"
                android:id="@+id/etRuleName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/rule_name_hint"
                android:inputType="text" />

            <!-- CONDITIONS SECTION -->
            <TextView
                android:fontFamily="@font/shabnam"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/conditions"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/purple_500"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp" />

            <!-- SIM Filter -->
            <TextView
                android:fontFamily="@font/shabnam"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sim_card"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />

            <Spinner
                android:fontFamily="@font/shabnam"
                android:id="@+id/spinnerSim"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp" />

            <!-- Sender Filter -->
            <TextView
                android:fontFamily="@font/shabnam"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sender_filter"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <Spinner
                android:fontFamily="@font/shabnam"
                android:id="@+id/spinnerSenderType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp" />

            <EditText
                android:fontFamily="@font/shabnam"
                android:id="@+id/etSenderValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/sender_hint"
                android:inputType="text"
                android:textDirection="ltr"
                />

            <!-- Message Filter -->
            <TextView
                android:fontFamily="@font/shabnam"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/message_filter"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <Spinner
                android:fontFamily="@font/shabnam"
                android:id="@+id/spinnerMessageType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp" />

            <EditText
                android:fontFamily="@font/shabnam"
                android:id="@+id/etMessageValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/message_hint"
                android:inputType="text" />

            <!-- ACTIONS SECTION -->
            <TextView
                android:fontFamily="@font/shabnam"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/actions"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/purple_500"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp" />

            <!-- Current Actions List -->
            <TextView
                android:fontFamily="@font/shabnam"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/current_actions"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp" />



            <Button
                android:fontFamily="@font/shabnam"
                android:id="@+id/btnAddAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/add_action"
                android:textSize="14sp"
                android:layout_marginTop="8dp"
                android:textStyle="bold"/>

            <!-- RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />


            <Button
                android:fontFamily="@font/shabnam"
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/save_rule"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>