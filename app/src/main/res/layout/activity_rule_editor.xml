<?xml version="1.0" encoding="utf-8"?>
<!--activity rule editor-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Header -->
            <TextView
                android:fontFamily="@font/shabnam"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/create_edit_rule"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:layout_marginBottom="16dp" />

            <!-- Rule Name -->
            <TextView
                android:fontFamily="@font/shabnam"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/rule_name"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />

            <EditText
                android:fontFamily="@font/shabnam"
                android:id="@+id/etRuleName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/rule_name_hint"
                android:inputType="text" />

            <!-- CONDITIONS SECTION -->
            <TextView
                android:fontFamily="@font/shabnam"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/conditions"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/purple_500"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp" />

            <!-- SIM Filter -->
            <TextView
                android:fontFamily="@font/shabnam"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sim_card"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />

            <Spinner
                android:fontFamily="@font/shabnam"
                android:id="@+id/spinnerSim"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp" />

            <!-- Sender Filter -->
            <TextView
                android:fontFamily="@font/shabnam"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sender_filter"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <Spinner
                android:fontFamily="@font/shabnam"
                android:id="@+id/spinnerSenderType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp" />

            <EditText
                android:fontFamily="@font/shabnam"
                android:id="@+id/etSenderValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/sender_hint"
                android:inputType="text"
                android:textDirection="ltr"
                />

            <!-- Message Filter -->
            <TextView
                android:fontFamily="@font/shabnam"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/message_filter"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <Spinner
                android:fontFamily="@font/shabnam"
                android:id="@+id/spinnerMessageType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp" />

            <EditText
                android:fontFamily="@font/shabnam"
                android:id="@+id/etMessageValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/message_hint"
                android:inputType="text" />

            <!-- ACTIONS SECTION -->
            <TextView
                android:fontFamily="@font/shabnam"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/actions"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/purple_500"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp" />

            <!-- Current Actions List -->
            <TextView
                android:fontFamily="@font/shabnam"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/current_actions"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp" />

            <!-- RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <!-- Action Form -->
            <TextView
                android:fontFamily="@font/shabnam"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/add_edit_action"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/actionFormLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#F5F5F5"
                android:padding="12dp">

                <TextView
                    android:fontFamily="@font/shabnam"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/action_type"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp" />

                <Spinner
                    android:fontFamily="@font/shabnam"
                    android:id="@+id/spinnerActionType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp" />

                <androidx.cardview.widget.CardView
                    android:id="@+id/webhookHelpCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="#FFF3E0"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="🌐 Webhook Information"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:fontFamily="@font/shabnam"
                            android:textColor="#E65100"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Method:"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            android:fontFamily="@font/shabnam"
                            android:textColor="#333333"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="POST"
                            android:textSize="11sp"
                            android:fontFamily="@font/shabnam"
                            android:textColor="#666666"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Content-Type:"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            android:fontFamily="@font/shabnam"
                            android:textColor="#333333" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="application/json"
                            android:textSize="11sp"
                            android:fontFamily="@font/shabnam"
                            android:textColor="#666666"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="JSON Payload Structure:"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            android:fontFamily="@font/shabnam"
                            android:textColor="#333333" />

                        <ScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxHeight="200dp"
                            android:layout_marginTop="4dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="{\n  &quot;from&quot;: &quot;+1234567890&quot;,\n  &quot;msg&quot;: &quot;Your processed message&quot;,\n  &quot;original_message&quot;: &quot;Original SMS text&quot;,\n  &quot;sim&quot;: &quot;SIM1&quot;,\n  &quot;timestamp&quot;: 1234567890123\n}"
                                android:textSize="10sp"
                                android:fontFamily="monospace"
                                android:textColor="#333333"
                                android:background="#FFFFFF"
                                android:padding="8dp"
                                android:textIsSelectable="true"
                                android:textDirection="ltr"
                                />

                        </ScrollView>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#E0E0E0"
                            android:layout_marginTop="12dp"
                            android:layout_marginBottom="8dp" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <TextView
                    android:fontFamily="@font/shabnam"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/destination"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp" />

                <EditText
                    android:fontFamily="@font/shabnam"
                    android:id="@+id/etActionDestination"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/destination_hint"
                    android:inputType="text"
                    android:textDirection="ltr"
                    />

                <TextView
                    android:fontFamily="@font/shabnam"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/message_template"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp" />

                <EditText
                    android:fontFamily="@font/shabnam"
                    android:id="@+id/etActionTemplate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/message_hint"
                    android:inputType="textMultiLine"
                    android:lines="3" />

                <!-- TELEGRAM FIELDS -->
                <LinearLayout
                    android:id="@+id/telegramFields"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#E3F2FD"
                    android:padding="12dp"
                    android:layout_marginTop="8dp"
                    android:visibility="gone">

                    <!-- Bot Token Field -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Telegram Bot Token (Optional)"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/shabnam"
                        android:layout_marginTop="8dp"
                        android:textDirection="ltr"
                        />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="💡 Leave empty to use app's default bot"
                        android:textSize="11sp"
                        android:fontFamily="@font/shabnam"
                        android:textColor="#FF9800"
                        android:layout_marginBottom="4dp"
                        />

                    <EditText
                        android:id="@+id/etBotToken"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="123456:ABC-DEF... (Leave empty for default bot)"
                        android:fontFamily="@font/shabnam"
                        android:inputType="text"
                        android:textSize="13sp"
                        android:textDirection="ltr"

                        />

                    <!-- Chat ID Field -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Telegram Chat ID (Required)"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/shabnam"
                        android:layout_marginTop="12dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="⚠️ Required: Send /getchatid to the bot to get your Chat ID"
                        android:textSize="11sp"
                        android:fontFamily="@font/shabnam"
                        android:textColor="#F44336"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/etChatId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="987654321 or -100123456789"
                        android:fontFamily="@font/shabnam"
                        android:inputType="text"
                        android:textSize="13sp"
                        android:textDirection="ltr"
                        />
                </LinearLayout>

                <!-- ============================================ -->
                <!-- NEW: MESSAGE TRANSFORMATION SECTION -->
                <!-- ============================================ -->

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="#CCCCCC" />

                <androidx.appcompat.widget.SwitchCompat
                    android:fontFamily="@font/shabnam"
                    android:id="@+id/switchEnableTransform"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/enable_transform"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/purple_500" />

                <LinearLayout
                    android:id="@+id/transformSettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:background="#EEEEEE"
                    android:padding="12dp"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:fontFamily="@font/shabnam"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/transform_type"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp" />

                    <Spinner
                        android:fontFamily="@font/shabnam"
                        android:id="@+id/spinnerTransformType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp" />

                    <TextView
                        android:fontFamily="@font/shabnam"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/transform_pattern"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginTop="12dp" />

                    <EditText
                        android:fontFamily="@font/shabnam"
                        android:id="@+id/etTransformPattern"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/see_examples_below"
                        android:inputType="text" />

                    <!-- Help text -->
                    <TextView
                        android:fontFamily="@font/shabnam"
                        android:id="@+id/tvTransformHelp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textSize="12sp"
                        android:textColor="@android:color/darker_gray"
                        android:background="#FFFFFF"
                        android:padding="8dp"
                        android:text="@string/select_transform_type_help" />

                    <!-- Test transformation button -->
                    <Button
                        android:fontFamily="@font/shabnam"
                        android:id="@+id/btnTestTransform"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/test_transformation"
                        android:textSize="14sp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

                </LinearLayout>

                <!-- END TRANSFORMATION SECTION -->

                <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- RETRY CONFIGURATION SECTION -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp"
                        android:background="#CCCCCC" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:fontFamily="@font/shabnam"
                        android:id="@+id/switchEnableRetry"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/enable_retry"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/purple_500"
                        android:checked="false" />

                    <LinearLayout
                        android:id="@+id/retrySettings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="#EEEEEE"
                        android:padding="12dp"
                        android:layout_marginTop="8dp"
                        android:visibility="gone">

                        <TextView
                            android:fontFamily="@font/shabnam"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/retry_configuration"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="12dp" />

                        <!-- Max Retries -->
                        <TextView
                            android:fontFamily="@font/shabnam"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/max_retry_attempts"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginTop="8dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <SeekBar
                                android:id="@+id/seekBarMaxRetries"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:max="5"
                                android:progress="3" />

                            <TextView
                                android:fontFamily="@font/shabnam"
                                android:id="@+id/tvMaxRetries"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="3"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:layout_marginStart="12dp"
                                android:minWidth="30dp"
                                android:gravity="center" />

                        </LinearLayout>

                        <!-- Retry Delay -->
                        <TextView
                            android:fontFamily="@font/shabnam"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/retry_delay"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginTop="12dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <SeekBar
                                android:fontFamily="@font/shabnam"
                                android:id="@+id/seekBarRetryDelay"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:max="60"
                                android:progress="5" />

                            <TextView
                                android:fontFamily="@font/shabnam"
                                android:id="@+id/tvRetryDelay"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="5s"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:layout_marginStart="12dp"
                                android:minWidth="40dp"
                                android:gravity="center" />

                        </LinearLayout>

                        <!-- Retry Strategy -->
                        <TextView
                            android:fontFamily="@font/shabnam"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/retry_strategy"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginTop="12dp" />

                        <Spinner
                            android:fontFamily="@font/shabnam"
                            android:id="@+id/spinnerRetryStrategy"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp" />

                        <TextView
                            android:fontFamily="@font/shabnam"
                            android:id="@+id/tvRetryStrategyHelp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textSize="11sp"
                            android:textColor="@android:color/darker_gray"
                            android:background="#FFFFFF"
                            android:padding="8dp"
                            android:text="@string/retry_strategy_help" />

                    </LinearLayout>

                    <!-- BACKUP ACTION SECTION -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp"
                        android:background="#CCCCCC" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:fontFamily="@font/shabnam"
                        android:id="@+id/switchEnableBackup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/enable_backup"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/purple_500"
                        android:checked="false" />

                    <LinearLayout
                        android:id="@+id/backupSettings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="#FFF3E0"
                        android:padding="12dp"
                        android:layout_marginTop="8dp"
                        android:visibility="gone">

                        <TextView
                            android:fontFamily="@font/shabnam"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/backup_configuration"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="12dp" />

                        <!-- Backup Type -->
                        <TextView
                            android:fontFamily="@font/shabnam"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/backup_type"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginTop="8dp" />

                        <Spinner
                            android:fontFamily="@font/shabnam"
                            android:id="@+id/spinnerBackupType"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp" />

                        <!-- Backup Destination -->
                        <TextView
                            android:fontFamily="@font/shabnam"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/backup_destination"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginTop="12dp" />

                        <EditText
                            android:fontFamily="@font/shabnam"
                            android:id="@+id/etBackupDestination"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="+1234567890"
                            android:inputType="phone"
                            android:textDirection="ltr"
                            />

                        <!-- Backup Template -->
                        <TextView
                            android:fontFamily="@font/shabnam"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/backup_template"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginTop="12dp" />

                        <EditText
                            android:fontFamily="@font/shabnam"
                            android:id="@+id/etBackupTemplate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/primary_action_failed"
                            android:inputType="textMultiLine"
                            android:lines="3" />

                        <!-- Backup Options -->
                        <CheckBox
                            android:fontFamily="@font/shabnam"
                            android:id="@+id/cbBackupAfterAllRetries"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/backup_after_retries"
                            android:checked="true" />

                        <CheckBox
                            android:fontFamily="@font/shabnam"
                            android:id="@+id/cbRetryBackup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/retry_backup" />

                        <TextView
                            android:fontFamily="@font/shabnam"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:textSize="11sp"
                            android:textColor="#F57C00"
                            android:background="#FFFFFF"
                            android:padding="8dp"
                            android:text="@string/backup_tip" />

                    </LinearLayout>

                    <!-- ERROR HANDLING OPTIONS -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp"
                        android:background="#CCCCCC" />

                    <TextView
                        android:fontFamily="@font/shabnam"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/error_handling"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/purple_500"
                        android:layout_marginBottom="8dp" />

                    <CheckBox
                        android:fontFamily="@font/shabnam"
                        android:id="@+id/cbContinueOnFailure"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/continue_on_failure"
                        android:checked="true" />

                    <CheckBox
                        android:fontFamily="@font/shabnam"
                        android:id="@+id/cbNotifyOnFailure"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/notify_on_failure"
                        android:checked="true" />

                    <CheckBox
                        android:fontFamily="@font/shabnam"
                        android:id="@+id/cbDetailedErrorLog"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/detailed_error_log"
                        android:checked="true" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <Button
                        android:fontFamily="@font/shabnam"
                        android:id="@+id/btnAddAction"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/add_action"
                        android:textSize="14sp" />

                    <Button
                        android:fontFamily="@font/shabnam"
                        android:id="@+id/btnCancelAction"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/cancel"
                        android:textSize="14sp"
                        android:visibility="gone"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
                </LinearLayout>

            </LinearLayout>

            <Button
                android:fontFamily="@font/shabnam"
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp"
                android:text="@string/save_rule"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>