<?xml version="1.0" encoding="utf-8"?>
<!--activity rule editor-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Header -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Create/Edit Rule"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:layout_marginBottom="16dp" />

            <!-- Rule Name -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Rule Name"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />

            <EditText
                android:id="@+id/etRuleName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="e.g., Bank Alerts"
                android:inputType="text" />

            <!-- CONDITIONS SECTION -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CONDITIONS"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/purple_500"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp" />

            <!-- SIM Filter -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SIM Card"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />

            <Spinner
                android:id="@+id/spinnerSim"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp" />

            <!-- Sender Filter -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sender Filter"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <Spinner
                android:id="@+id/spinnerSenderType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp" />

            <EditText
                android:id="@+id/etSenderValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="e.g., BANK or +1234567890"
                android:inputType="text" />

            <!-- Message Filter -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Message Filter"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <Spinner
                android:id="@+id/spinnerMessageType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp" />

            <EditText
                android:id="@+id/etMessageValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="e.g., OTP or credited"
                android:inputType="text" />

            <!-- ACTIONS SECTION -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ACTIONS"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/purple_500"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp" />

            <!-- Current Actions List -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Current Actions:"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp" />

            <!-- RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <!-- Action Form -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Add/Edit Action:"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/actionFormLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#F5F5F5"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Action Type"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp" />

                <Spinner
                    android:id="@+id/spinnerActionType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Destination (URL/Phone)"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp" />

                <EditText
                    android:id="@+id/etActionDestination"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="e.g., https://api.example.com or +1234567890"
                    android:inputType="text" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Message Template (Variables: {sender}, {message}, {sim}, {date})"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp" />

                <EditText
                    android:id="@+id/etActionTemplate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="e.g., SMS from {sender}: {message}"
                    android:inputType="textMultiLine"
                    android:lines="3" />

                <!-- TELEGRAM FIELDS -->
                <LinearLayout
                    android:id="@+id/telegramFields"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Telegram Bot Token"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginTop="16dp" />

                    <EditText
                        android:id="@+id/etBotToken"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="123456:ABC-DEF..."
                        android:inputType="text" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Telegram Chat ID"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp" />

                    <EditText
                        android:id="@+id/etChatId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="987654321"
                        android:inputType="text" />
                </LinearLayout>

                <!-- ============================================ -->
                <!-- NEW: MESSAGE TRANSFORMATION SECTION -->
                <!-- ============================================ -->

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="#CCCCCC" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchEnableTransform"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Enable Message Transformation"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/purple_500" />

                <LinearLayout
                    android:id="@+id/transformSettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:background="#EEEEEE"
                    android:padding="12dp"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Transform Type"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp" />

                    <Spinner
                        android:id="@+id/spinnerTransformType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Transform Pattern/Value"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginTop="12dp" />

                    <EditText
                        android:id="@+id/etTransformPattern"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="See examples below"
                        android:inputType="text" />

                    <!-- Help text -->
                    <TextView
                        android:id="@+id/tvTransformHelp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textSize="12sp"
                        android:textColor="@android:color/darker_gray"
                        android:background="#FFFFFF"
                        android:padding="8dp"
                        android:text="Select a transform type to see examples." />

                    <!-- Test transformation button -->
                    <Button
                        android:id="@+id/btnTestTransform"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Test Transformation"
                        android:textSize="14sp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

                </LinearLayout>

                <!-- END TRANSFORMATION SECTION -->

                <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- RETRY CONFIGURATION SECTION -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp"
                        android:background="#CCCCCC" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchEnableRetry"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🔄 Enable Automatic Retry on Failure"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/purple_500"
                        android:checked="true" />

                    <LinearLayout
                        android:id="@+id/retrySettings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="#EEEEEE"
                        android:padding="12dp"
                        android:layout_marginTop="8dp"
                        android:visibility="visible">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="⚙️ Retry Configuration"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="12dp" />

                        <!-- Max Retries -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Maximum Retry Attempts"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginTop="8dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <SeekBar
                                android:id="@+id/seekBarMaxRetries"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:max="5"
                                android:progress="3" />

                            <TextView
                                android:id="@+id/tvMaxRetries"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="3"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:layout_marginStart="12dp"
                                android:minWidth="30dp"
                                android:gravity="center" />

                        </LinearLayout>

                        <!-- Retry Delay -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Delay Between Retries (seconds)"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginTop="12dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <SeekBar
                                android:id="@+id/seekBarRetryDelay"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:max="60"
                                android:progress="5" />

                            <TextView
                                android:id="@+id/tvRetryDelay"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="5s"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:layout_marginStart="12dp"
                                android:minWidth="40dp"
                                android:gravity="center" />

                        </LinearLayout>

                        <!-- Retry Strategy -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Retry Strategy"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginTop="12dp" />

                        <Spinner
                            android:id="@+id/spinnerRetryStrategy"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp" />

                        <TextView
                            android:id="@+id/tvRetryStrategyHelp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textSize="11sp"
                            android:textColor="@android:color/darker_gray"
                            android:background="#FFFFFF"
                            android:padding="8dp"
                            android:text="• Immediate: Retry instantly\n• Fixed Delay: Wait same time between retries\n• Exponential Backoff: Double wait time each retry (5s, 10s, 20s...)" />

                    </LinearLayout>

                    <!-- BACKUP ACTION SECTION -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp"
                        android:background="#CCCCCC" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchEnableBackup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🔀 Enable Backup Action on Failure"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/purple_500"
                        android:checked="true" />

                    <LinearLayout
                        android:id="@+id/backupSettings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="#FFF3E0"
                        android:padding="12dp"
                        android:layout_marginTop="8dp"
                        android:visibility="visible">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="⚙️ Backup Action Configuration"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="12dp" />

                        <!-- Backup Type -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Backup Action Type"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginTop="8dp" />

                        <Spinner
                            android:id="@+id/spinnerBackupType"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp" />

                        <!-- Backup Destination -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Backup Destination (Phone Number)"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginTop="12dp" />

                        <EditText
                            android:id="@+id/etBackupDestination"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="+1234567890"
                            android:inputType="phone" />

                        <!-- Backup Template -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Backup Message Template"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginTop="12dp" />

                        <EditText
                            android:id="@+id/etBackupTemplate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="⚠️ Primary action failed: {message}"
                            android:inputType="textMultiLine"
                            android:lines="3" />

                        <!-- Backup Options -->
                        <CheckBox
                            android:id="@+id/cbBackupAfterAllRetries"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Trigger backup only after all retries fail"
                            android:checked="true" />

                        <CheckBox
                            android:id="@+id/cbRetryBackup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Retry backup action if it fails (2 attempts)" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:textSize="11sp"
                            android:textColor="#F57C00"
                            android:background="#FFFFFF"
                            android:padding="8dp"
                            android:text="💡 TIP: SMS backup is recommended for critical notifications. It provides reliable fallback when primary actions fail." />

                    </LinearLayout>

                    <!-- ERROR HANDLING OPTIONS -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp"
                        android:background="#CCCCCC" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="⚙️ Error Handling Options"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/purple_500"
                        android:layout_marginBottom="8dp" />

                    <CheckBox
                        android:id="@+id/cbContinueOnFailure"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Continue processing other actions if this fails"
                        android:checked="true" />

                    <CheckBox
                        android:id="@+id/cbNotifyOnFailure"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Send notification on action failure"
                        android:checked="true" />

                    <CheckBox
                        android:id="@+id/cbDetailedErrorLog"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Log detailed error information"
                        android:checked="true" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnAddAction"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Add Action"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/btnCancelAction"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="Cancel"
                        android:textSize="14sp"
                        android:visibility="gone"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
                </LinearLayout>

            </LinearLayout>

            <Button
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp"
                android:text="Save Rule"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>