<?xml version="1.0" encoding="utf-8"?>
<!--item_sms_log.xml - Complete SMS details display-->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Header: Sender and SIM -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvSender"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/sender"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#333333" />

            <TextView
                android:id="@+id/tvSimSlot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sim_slot"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="#E3F2FD"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginStart="8dp" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginStart="8dp" />

        </LinearLayout>

        <!-- Message Body -->
        <TextView
            android:id="@+id/tvMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/message"
            android:textSize="14sp"
            android:textColor="#666666"
            android:maxLines="3"
            android:ellipsize="end" />

        <!-- Date/Time -->
        <TextView
            android:id="@+id/tvDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/time"
            android:textSize="12sp"
            android:textColor="#999999" />

        <!-- Rule Info -->
        <TextView
            android:id="@+id/tvRule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="📋 Rule: Bank Alerts"
            android:textSize="12sp"
            android:textColor="#2196F3"
            android:visibility="gone" />

        <!-- Actions Executed -->
        <TextView
            android:id="@+id/tvActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="🚀 Actions: Webhook, Telegram"
            android:textSize="12sp"
            android:textColor="#4CAF50"
            android:visibility="gone" />

        <!-- Transformation Info -->
        <TextView
            android:id="@+id/tvTransform"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="🔄 Transformed (EXTRACT_PATTERN)"
            android:textSize="12sp"
            android:textColor="#FF9800"
            android:visibility="gone" />

        <!-- Credits Used -->
        <TextView
            android:id="@+id/tvCredits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/credits_used"
            android:textSize="12sp"
            android:textColor="#FF9800" />

    </LinearLayout>

</androidx.cardview.widget.CardView>