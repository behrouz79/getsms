<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginVertical="4dp"
    android:background="@drawable/bg_card"
    android:padding="14dp">

    <!-- Header row: sender + SIM + status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvSender"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/sender"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="@font/shabnam_bold"
            android:textColor="@color/claude_text_primary" />

        <TextView
            android:id="@+id/tvSimSlot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sim_slot"
            android:textSize="11sp"
            android:fontFamily="@font/shabnam"
            android:textColor="@color/claude_info_text"
            android:background="@drawable/bg_tag_blue"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:layout_marginStart="6dp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/status"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="@font/shabnam"
            android:layout_marginStart="6dp" />

    </LinearLayout>

    <!-- Message body -->
    <TextView
        android:id="@+id/tvMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/message"
        android:textSize="13sp"
        android:fontFamily="@font/shabnam"
        android:textColor="@color/claude_text_secondary"
        android:maxLines="3"
        android:ellipsize="end" />

    <!-- Date/time -->
    <TextView
        android:id="@+id/tvDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/time"
        android:textSize="11sp"
        android:fontFamily="@font/shabnam"
        android:textColor="@color/claude_text_hint" />

    <!-- Rule matched -->
    <TextView
        android:id="@+id/tvRule"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textSize="11sp"
        android:fontFamily="@font/shabnam"
        android:textColor="@color/claude_primary"
        android:visibility="gone" />

    <!-- Actions executed -->
    <TextView
        android:id="@+id/tvActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textSize="11sp"
        android:fontFamily="@font/shabnam"
        android:textColor="@color/claude_success"
        android:visibility="gone" />

    <!-- Transformation info -->
    <TextView
        android:id="@+id/tvTransform"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textSize="11sp"
        android:fontFamily="@font/shabnam"
        android:textColor="@color/claude_warning"
        android:visibility="gone" />

    <!-- Credits used -->
    <TextView
        android:id="@+id/tvCredits"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="@string/credits_used"
        android:textSize="11sp"
        android:fontFamily="@font/shabnam"
        android:textColor="@color/claude_text_hint" />

</LinearLayout>
