<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- ── Top app bar (52dp) ─────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingEnd="4dp"
        android:background="@color/background">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="←"
            android:textSize="18sp"
            android:textColor="@color/text_primary"
            android:fontFamily="@font/shabnam" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/add_edit_action"
            style="@style/Text.PageTitle" />

        <TextView
            android:id="@+id/tvSave"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="✓"
            android:textSize="18sp"
            android:textColor="@color/text_primary"
            android:fontFamily="@font/shabnam" />

    </LinearLayout>

    <!-- hairline -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- ── Scrollable form ────────────────────────────────── -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp">

            <!-- ── TYPE ──────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="10dp"
                android:paddingBottom="6dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="TYPE"
                    style="@style/Text.SectionHeader" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />

            <!-- Segmented type selector -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/tvTypeWebhook"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:gravity="center"
                    android:text="@string/webhook"
                    android:textSize="13sp"
                    android:fontFamily="@font/shabnam_bold"
                    android:textColor="@color/text_on_primary"
                    android:background="@drawable/bg_type_btn_active" />

                <TextView
                    android:id="@+id/tvTypeSms"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:gravity="center"
                    android:text="@string/sms"
                    android:textSize="13sp"
                    android:fontFamily="@font/shabnam_bold"
                    android:textColor="@color/text_primary"
                    android:background="@drawable/bg_type_btn_idle" />

                <TextView
                    android:id="@+id/tvTypeTelegram"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:gravity="center"
                    android:text="@string/telegram"
                    android:textSize="13sp"
                    android:fontFamily="@font/shabnam_bold"
                    android:textColor="@color/text_primary"
                    android:background="@drawable/bg_type_btn_idle" />

            </LinearLayout>

            <!-- Hidden spinner — SpinnerHelper reads/writes value -->
            <Spinner
                android:id="@+id/spinnerActionType"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:visibility="gone" />

            <!-- ── DESTINATION ────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="10dp"
                android:paddingBottom="6dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="DESTINATION"
                    style="@style/Text.SectionHeader" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="8dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/webhook_url_hint"
                    style="@style/Input.Outlined">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etActionDestination"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:textDirection="ltr"
                        android:fontFamily="monospace" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Webhook helper text (shown when Webhook selected) -->
                <TextView
                    android:id="@+id/webhookHelpCard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="POST · application/json"
                    style="@style/Text.Caption"
                    android:visibility="gone" />

                <!-- Telegram-specific fields (shown when Telegram selected) -->
                <LinearLayout
                    android:id="@+id/telegramFields"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="@string/telegram_bot_token"
                        style="@style/Text.Caption" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/telegram_default_bot_info"
                        style="@style/Input.Outlined">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etBotToken"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:textDirection="ltr"
                            android:fontFamily="monospace" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="4dp"
                        android:text="@string/telegram_chat_id"
                        style="@style/Text.Caption" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="987654321 or -100123456789"
                        style="@style/Input.Outlined">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etChatId"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:textDirection="ltr"
                            android:fontFamily="monospace" />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- ── MESSAGE TEMPLATE ───────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="10dp"
                android:paddingBottom="6dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="MESSAGE TEMPLATE"
                    style="@style/Text.SectionHeader" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="8dp">

                <!-- Monospace template editor -->
                <EditText
                    android:id="@+id/etActionTemplate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:padding="12dp"
                    android:fontFamily="monospace"
                    android:textSize="12sp"
                    android:textColor="@color/text_primary"
                    android:inputType="textMultiLine"
                    android:minLines="4"
                    android:gravity="top|start"
                    android:hint="{message}" />

                <!-- Variable badges -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:text="{sender}"
                        style="@style/Text.Badge"
                        android:textColor="@color/text_secondary"
                        android:background="@drawable/bg_badge_neutral" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:text="{message}"
                        style="@style/Text.Badge"
                        android:textColor="@color/text_secondary"
                        android:background="@drawable/bg_badge_neutral" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:text="{timestamp}"
                        style="@style/Text.Badge"
                        android:textColor="@color/text_secondary"
                        android:background="@drawable/bg_badge_neutral" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:text="{sim}"
                        style="@style/Text.Badge"
                        android:textColor="@color/text_secondary"
                        android:background="@drawable/bg_badge_neutral" />

                </LinearLayout>

            </LinearLayout>

            <!-- ── TRANSFORM (header with toggle) ────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="8dp"
                android:paddingTop="10dp"
                android:paddingBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="TRANSFORM"
                    style="@style/Text.SectionHeader" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchEnableTransform"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:theme="@style/ThemeOverlay.Toggle" />

            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />

            <!-- Transform settings (toggled by switch) -->
            <LinearLayout
                android:id="@+id/transformSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="TRANSFORM TYPE"
                    style="@style/Text.Caption" />

                <Spinner
                    android:id="@+id/spinnerTransformType"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="12dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="EXTRACT (REGEX) / PATTERN"
                    style="@style/Input.Outlined">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etTransformPattern"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:fontFamily="monospace" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/tvTransformHelp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    style="@style/Text.Caption"
                    android:background="@drawable/bg_card"
                    android:padding="10dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTestTransform"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="12dp"
                    android:text="TEST TRANSFORM"
                    android:textAllCaps="false"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    style="@style/Button.Outline"
                    app:cornerRadius="4dp" />

            </LinearLayout>

            <!-- ── RETRY (header with toggle) ─────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="8dp"
                android:paddingTop="10dp"
                android:paddingBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="RETRY"
                    style="@style/Text.SectionHeader" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchEnableRetry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:theme="@style/ThemeOverlay.Toggle" />

            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />

            <!-- Retry settings (toggled by switch) -->
            <LinearLayout
                android:id="@+id/retrySettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="8dp">

                <!-- MAX RETRIES + DELAY in two columns -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="MAX RETRIES"
                            style="@style/Text.Caption" />

                        <SeekBar
                            android:id="@+id/seekBarMaxRetries"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:max="5"
                            android:progress="3" />

                        <TextView
                            android:id="@+id/tvMaxRetries"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:text="3"
                            style="@style/Text.BodyStrong" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="DELAY (S)"
                            style="@style/Text.Caption" />

                        <SeekBar
                            android:id="@+id/seekBarRetryDelay"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:max="60"
                            android:progress="5" />

                        <TextView
                            android:id="@+id/tvRetryDelay"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:text="5s"
                            style="@style/Text.BodyStrong" />

                    </LinearLayout>

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="4dp"
                    android:text="STRATEGY"
                    style="@style/Text.Caption" />

                <Spinner
                    android:id="@+id/spinnerRetryStrategy"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvRetryStrategyHelp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Text.Caption"
                    android:background="@drawable/bg_card"
                    android:padding="10dp" />

            </LinearLayout>

            <!-- ── BACKUP ACTION (header with toggle) ─────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="8dp"
                android:paddingTop="10dp"
                android:paddingBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="BACKUP ACTION"
                    style="@style/Text.SectionHeader" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchEnableBackup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:theme="@style/ThemeOverlay.Toggle" />

            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />

            <!-- Backup description — always visible -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="4dp"
                android:text="Run a fallback when this action fails after all retries."
                style="@style/Text.Caption" />

            <!-- Backup settings (toggled by switch) -->
            <LinearLayout
                android:id="@+id/backupSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="4dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="BACKUP TYPE"
                    style="@style/Text.Caption" />

                <Spinner
                    android:id="@+id/spinnerBackupType"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="12dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="PHONE NUMBER"
                    style="@style/Input.Outlined">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etBackupDestination"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="phone"
                        android:textDirection="ltr" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="TEMPLATE"
                    style="@style/Input.Outlined">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etBackupTemplate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textMultiLine"
                        android:lines="2"
                        android:fontFamily="monospace" />
                </com.google.android.material.textfield.TextInputLayout>

                <CheckBox
                    android:id="@+id/cbBackupAfterAllRetries"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/backup_after_retries"
                    android:fontFamily="@font/shabnam"
                    android:checked="true" />

                <CheckBox
                    android:id="@+id/cbRetryBackup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/retry_backup"
                    android:fontFamily="@font/shabnam" />

            </LinearLayout>

            <!-- ── ERROR HANDLING ─────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="10dp"
                android:paddingBottom="6dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ERROR HANDLING"
                    style="@style/Text.SectionHeader" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="20dp">

                <!-- Notify on failure row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:background="@drawable/bg_card">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/notify_on_failure"
                        style="@style/Text.Body" />
                    <CheckBox
                        android:id="@+id/cbNotifyOnFailure"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:checked="true" />
                </LinearLayout>

                <!-- Detailed error log row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:background="@drawable/bg_card">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/detailed_error_log"
                        style="@style/Text.Body" />
                    <CheckBox
                        android:id="@+id/cbDetailedErrorLog"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:checked="true" />
                </LinearLayout>

                <!-- Continue on failure row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:background="@drawable/bg_card">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/continue_on_failure"
                        style="@style/Text.Body" />
                    <CheckBox
                        android:id="@+id/cbContinueOnFailure"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:checked="true" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ── Bottom save bar ────────────────────────────────── -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            android:text="@string/cancel"
            android:textAllCaps="false"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            style="@style/Button.Outline"
            app:cornerRadius="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveAction"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="@string/save_action"
            android:textAllCaps="false"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="@color/text_primary"
            style="@style/Button.Primary"
            app:cornerRadius="4dp" />

    </LinearLayout>

</LinearLayout>
