<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/claude_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="24dp"
        android:paddingBottom="32dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/credits_manager"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="@font/shabnam_bold"
            android:textColor="@color/claude_text_primary"
            android:layout_marginBottom="20dp" />

        <!-- Balance card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp"
            android:gravity="center"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvCredits"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/available_credits"
                android:textSize="32sp"
                android:textStyle="bold"
                android:fontFamily="@font/shabnam_bold"
                android:textColor="@color/claude_primary"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvAdStats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ads_watched"
                android:textSize="13sp"
                android:fontFamily="@font/shabnam"
                android:textColor="@color/claude_text_secondary" />

        </LinearLayout>

        <!-- Reset timer -->
        <TextView
            android:id="@+id/tvResetTimer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Counter resets in: 5h 30m"
            android:textSize="12sp"
            android:textColor="@color/claude_text_secondary"
            android:gravity="center"
            android:background="@drawable/bg_card"
            android:padding="10dp"
            android:fontFamily="@font/shabnam"
            android:layout_marginBottom="10dp" />

        <!-- Cooldown timer -->
        <TextView
            android:id="@+id/tvCooldownTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Next ad in: 30s"
            android:textSize="13sp"
            android:textColor="@color/claude_warning"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal"
            android:visibility="gone"
            android:layout_marginBottom="8dp" />

        <!-- Watch ad button -->
        <Button
            android:id="@+id/btnWatchAd"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/watch_ad"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="@font/shabnam"
            android:background="@drawable/btn_success"
            android:textColor="@color/white"
            android:layout_marginBottom="10dp" />

        <!-- Redeem token button -->
        <Button
            android:id="@+id/btnRedeemToken"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/redeem_token"
            android:textSize="15sp"
            android:fontFamily="@font/shabnam"
            android:background="@drawable/btn_primary"
            android:textColor="@color/white"
            android:layout_marginBottom="10dp" />

        <!-- Info button (invisible placeholder) -->
        <Button
            android:id="@+id/btnInfo"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="@string/how_credits_work"
            android:textSize="13sp"
            android:fontFamily="@font/shabnam"
            android:background="@drawable/btn_outline"
            android:textColor="@color/claude_text_secondary"
            android:layout_marginBottom="20dp"
            android:visibility="gone" />

        <!-- Progress -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <!-- Info text -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/credit_info"
            android:textSize="12sp"
            android:fontFamily="@font/shabnam"
            android:textColor="@color/claude_text_hint"
            android:gravity="center"
            android:layout_marginTop="16dp" />

    </LinearLayout>

</ScrollView>
