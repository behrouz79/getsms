    <!-- Transform Examples -->
    <string name="transform_extract_lines">استخراج خطوط خاص.\nمثال: ۱,۲,۳ (خطوط ۱، ۲ و ۳ را استخراج می‌کند)\n\nمثال شما:\nدریافتی: خط۱\nخط۲\nخط۳\nخط۴\nالگو: ۱,۲\nنتیجه: خط۱\nخط۲</string>
    <string name="transform_remove_lines">حذف خطوط خاص.\nمثال: ۳,۴ (خطوط ۳ و ۴ را حذف می‌کند)\n\nمثال شما:\nدریافتی: خط۱\nخط۲\nموجودی: ۷۵۷\nخط۴\nالگو: ۳\nنتیجه: خط۱\nخط۲\nخط۴</string>
    <string name="transform_extract_pattern">استخراج متن منطبق با regex.\nمثال: حساب\\d+ (شماره حساب را استخراج می‌کند)\n\nمثال شما:\nدریافتی: حساب۵۶۹۴۵۴۱۹۳۱\nبرداشت۱۰۰,۰۰۰\nالگو: حساب\\d+|برداشت[\\d,]+\nنتیجه: حساب۵۶۹۴۵۴۱۹۳۱\nبرداشت۱۰۰,۰۰۰</string>
    <string name="transform_remove_pattern">حذف متن منطبق با regex.\nمثال: موجودی:.* (خط موجودی را حذف می‌کند)\n\nمثال شما:\nدریافتی: بلو\nانتقال پل\nموجودی: ۷۵۷ ریال\nالگو: موجودی:.*\nنتیجه: بلو\nانتقال پل</string>
    <string name="transform_replace_pattern">جایگزینی متن منطبق با regex.\nفرمت: الگو|جایگزین\nمثال: موجودی:.*| (موجودی را با هیچ جایگزین می‌کند)</string>
    <string name="transform_keep_until">نگه‌داشتن متن تا زمان یافتن الگو.\nمثال: موجودی (همه چیز قبل از موجودی را نگه می‌دارد)</string>
    <string name="transform_keep_after">نگه‌داشتن متن بعد از یافتن الگو.\nمثال: حساب (از حساب به بعد را نگه می‌دارد)</string>
    <string name="transform_remove_after">حذف متن بعد از یافتن الگو.\nمثال: موجودی (از موجودی به بعد را حذف می‌کند)\n\nمثال شما:\nدریافتی: بلو\nانتقال پل\nموجودی: ۷۵۷\nالگو: موجودی\nنتیجه: بلو\nانتقال پل</string>
    <string name="transform_default">یک نوع تبدیل انتخاب کنید تا مثال‌ها را ببینید.</string>

