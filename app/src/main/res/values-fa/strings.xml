    <string name="more_credits_message">\"To purchase more credits:\\n\\n\" +\n                \"1. Contact the administrator\\n\" +\n                \"3. Receive your token code\\n\" +\n                \"4. Enter the code in the app\\n\\n\"</string>
    <string name="enter_backup_telegram_chat_id">چت ایدی بکاپ را وارد کنید</string>
