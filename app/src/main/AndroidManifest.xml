<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ============================================ -->
    <!-- SMS PERMISSIONS (REQUIRED) -->
    <!-- ============================================ -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- For dual SIM support -->
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />

    <!-- ============================================ -->
    <!-- NETWORK PERMISSIONS -->
    <!-- ============================================ -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- ============================================ -->
    <!-- FOREGROUND SERVICE PERMISSIONS -->
    <!-- ============================================ -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"
        android:minSdkVersion="34" />

    <!-- ============================================ -->
    <!-- NOTIFICATION PERMISSIONS (Android 13+) -->
    <!-- ============================================ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ============================================ -->
    <!-- ADS PERMISSIONS -->
    <!-- ============================================ -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID"/>

    <!-- ============================================ -->
    <!-- WAKE LOCK (Optional - for background processing) -->
    <!-- ============================================ -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GetSMS"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <!-- AdMob App ID -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713"/>

        <!-- ============================================ -->
        <!-- ACTIVITIES -->
        <!-- ============================================ -->

        <!-- Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Credits Activity -->
        <activity
            android:name=".CreditsActivity"
            android:exported="false"
            android:label="Credits"/>

        <!-- Rules Management Activity -->
        <activity
            android:name=".RulesActivity"
            android:label="SMS Rules"
            android:parentActivityName=".MainActivity"
            android:exported="false" />

        <!-- Rule Editor Activity -->
        <activity
            android:name=".RuleEditorActivity"
            android:label="Edit Rule"
            android:parentActivityName=".RulesActivity"
            android:exported="false" />

        <!-- ============================================ -->
        <!-- SMS RECEIVER -->
        <!-- ============================================ -->
        <receiver
            android:name=".ReceiveSms"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- ============================================ -->
        <!-- FOREGROUND SERVICE -->
        <!-- ============================================ -->
        <service
            android:name=".EndlessService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

    </application>

</manifest>